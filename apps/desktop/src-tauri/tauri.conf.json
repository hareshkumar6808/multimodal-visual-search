{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Multimodal Visual Search",
  "version": "0.1.0",
  "identifier": "dev.multimodalvisualsearch.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "widget",
        "title": "Visual Search",
        "url": "index.html?view=widget",
        "width": 64,
        "height": 64,
        "minWidth": 64,
        "minHeight": 64,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "resizable": false,
        "skipTaskbar": true,
        "shadow": false
      },
      {
        "label": "capture",
        "title": "Select an area",
        "url": "index.html?view=capture",
        "width": 800,
        "height": 600,
        "decorations": false,
        "transparent": false,
        "alwaysOnTop": true,
        "resizable": false,
        "skipTaskbar": true,
        "visible": false
      },
      {
        "label": "chat",
        "title": "Visual Search",
        "url": "index.html?view=chat",
        "width": 440,
        "height": 650,
        "minWidth": 360,
        "minHeight": 500,
        "resizable": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "targets": "all"
  }
}
