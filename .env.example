APP_ENV=development
PERCEPTION_MODE=real
PERCEPTION_MODULE=services.perception

# Provider model identifiers are deliberately required configuration. Consult each
# provider's current model listing before selecting one.
TESSERACT_CMD=
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=
NVIDIA_SUPPORTS_VISION=false
NVIDIA_DAILY_BUDGET=0

GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=
GEMINI_DAILY_BUDGET=0

# OpenAI-compatible local service started by scripts/run-stage1.ps1.
LOCAL_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_MODEL=qwen2.5-3b-instruct
LOCAL_API_KEY=
LOCAL_SUPPORTS_VISION=false
LOCAL_DAILY_BUDGET=0
