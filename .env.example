APP_ENV=development
PERCEPTION_MODE=real
PERCEPTION_MODULE=services.perception

# Provider model identifiers are deliberately required configuration. Consult each
# provider's current model listing before selecting one.
TESSERACT_CMD=
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=
NVIDIA_SUPPORTS_VISION=false
NVIDIA_DAILY_BUDGET=0

GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=
GEMINI_DAILY_BUDGET=0

# Optional OpenAI-compatible local service (for example, a local inference server).
LOCAL_BASE_URL=
LOCAL_MODEL=
LOCAL_API_KEY=
LOCAL_SUPPORTS_VISION=false
LOCAL_DAILY_BUDGET=0

